<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Webhook Queue form view -->
    <record id="view_mautic_webhook_queue_form" model="ir.ui.view">
        <field name="name">mautic.webhook.queue.form</field>
        <field name="model">mautic.webhook.queue</field>
        <field name="arch" type="xml">
            <form string="Mautic Webhook Queue">
                <header>
                    <button
                        name="action_process_queue"
                        string="Process"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                        groups="connector.group_connector_manager"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,done"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group string="Queue Info">
                            <field name="backend_id" />
                            <field name="lead_id" />
                        </group>
                        <group string="Status">
                            <field name="create_date" string="Received At" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload" name="payload">
                            <field name="payload_data" />
                        </page>
                        <page
                            string="Error Log"
                            name="error_log"
                            attrs="{'invisible': [('state', '!=', 'error')]}"
                        >
                            <field name="error_log" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Webhook Queue list/tree view -->
    <record id="view_mautic_webhook_queue_tree" model="ir.ui.view">
        <field name="name">mautic.webhook.queue.tree</field>
        <field name="model">mautic.webhook.queue</field>
        <field name="arch" type="xml">
            <tree
                string="Mautic Webhook Queue"
                decoration-success="state == 'done'"
                decoration-danger="state == 'error'"
                decoration-muted="state == 'draft'"
            >
                <field name="name" />
                <field name="backend_id" />
                <field name="lead_id" />
                <field name="state" />
                <field name="create_date" string="Received At" />
            </tree>
        </field>
    </record>

    <!-- Webhook Queue action -->
    <record id="action_mautic_webhook_queue" model="ir.actions.act_window">
        <field name="name">Forms</field>
        <field name="res_model">mautic.webhook.queue</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_state_draft': 1}</field>
    </record>
</odoo>
